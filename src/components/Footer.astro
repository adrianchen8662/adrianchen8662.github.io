---
import { BLOGS, blogUrl } from '../blogs';
import { PROFILES, SITE } from '../site';

const REPO = 'https://github.com/adrianchen8662/adrianchen8662.github.io';

const pages = [
  { name: 'Resume', href: '/resume/' },
  { name: 'About', href: '/about/' },
  { name: 'Contact', href: '/contact/' },
];
const blogs = BLOGS.map((blog) => ({ name: blog.name, href: blogUrl(blog) }));
const profiles = PROFILES.filter((profile) => profile.icon);

const icons = {
  github:
    'M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z',
  linkedin:
    'M19,19H16V13.7A1.5,1.5 0 0,0 14.5,12.2A1.5,1.5 0 0,0 13,13.7V19H10V10H13V11.2C13.5,10.36 14.59,9.8 15.5,9.8A3.5,3.5 0 0,1 19,13.3M6.5,8.31C5.5,8.31 4.69,7.5 4.69,6.5A1.81,1.81 0 0,1 6.5,4.69C7.5,4.69 8.31,5.5 8.31,6.5A1.81,1.81 0 0,1 6.5,8.31M8,19H5V10H8M20,2H4C2.89,2 2,2.89 2,4V20A2,2 0 0,0 4,22H20A2,2 0 0,0 22,20V4C22,2.89 21.1,2 20,2Z',
};
---
<footer class="site-footer">
  <div class="container footer-columns">
    <ul>
      {pages.map((link) => <li><a href={link.href}>{link.name}</a></li>)}
    </ul>
    <ul>
      {blogs.map((link) => <li><a href={link.href}>{link.name}</a></li>)}
    </ul>
    <ul>
      {profiles.map((profile) => (
        <li>
          <a href={profile.href} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[profile.icon!]} /></svg>{profile.name}
          </a>
        </li>
      ))}
    </ul>
  </div>
  <p class="footer-license container">
    © {new Date().getFullYear()} {SITE.name}. Content is all rights reserved;
    <a href={`${REPO}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">the code is MIT licensed</a>.
  </p>
</footer>
