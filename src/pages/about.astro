---
import PageLayout from '../layouts/PageLayout.astro';
import NowPlayingCard from '../components/NowPlayingCard';
import MostPlayed from '../components/MostPlayed';
import { LISTENBRAINZ_USER, PROFILES } from '../site';
---
<PageLayout title="About" descriptionHtml="The man himself!">
  <div class="about">
    <div class="about-text">
      <p class="about-lead">
        I am a Purdue University graduate with a B.S. in Computer Engineering and currently work as a Software Engineer
        at ASRC Federal.
      </p>
      <p>I am also pursuing a Master’s in Computer Science at NJIT's Ying Wu College of Computing.</p>
      <p><a href="/#timeline">See where I've worked and studied &rarr;</a></p>

      <ul class="about-profiles" aria-label="Elsewhere">
        {PROFILES.map((profile) => (
          <li><a href={profile.href} target="_blank" rel="noopener noreferrer">{profile.name}</a></li>
        ))}
      </ul>
    </div>

    <aside class="about-listening" aria-label="What I'm listening to">
      <NowPlayingCard client:visible username={LISTENBRAINZ_USER} />
      <p class="about-more">
        <a href={`https://listenbrainz.org/user/${LISTENBRAINZ_USER}/`}>See my full listening history on ListenBrainz</a>
      </p>
    </aside>

    <section class="about-most-played" aria-labelledby="most-played">
      <h2 id="most-played">Most played</h2>
      <MostPlayed client:visible username={LISTENBRAINZ_USER} />
    </section>
  </div>
</PageLayout>
