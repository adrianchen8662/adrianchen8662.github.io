---
import PageLayout from '../layouts/PageLayout.astro';
import ListenBrainzCard from '../components/ListenBrainzCard';
import { PROFILES } from '../site';
---
<PageLayout title="About" descriptionHtml="The man himself!">
  <div class="about">
    <div class="about-text">
      <p class="about-lead">
        I am a Purdue University graduate with a B.S. in Computer Engineering and currently work as a Software Engineer
        at ASRC Federal.
      </p>
      <p>I am also pursuing a Master’s in Computer Science at NJIT's Ying Wu College of Computing.</p>
      <p>
        I like all things open-source, and tinkering with various little projects to expand my knowledge of computing.
        I'm an amateur cook, and the only food I can't stand are boiled eggs.
      </p>
      <p><a href="/#timeline">See where I've worked and studied &rarr;</a></p>

      <ul class="about-profiles" aria-label="Elsewhere">
        {PROFILES.map((profile) => (
          <li><a href={profile.href} target="_blank" rel="noopener noreferrer">{profile.name}</a></li>
        ))}
      </ul>
    </div>

    <aside class="about-listening" aria-label="What I'm listening to">
      <ListenBrainzCard client:visible username="adrianchen8662" />
      <p class="about-more">
        <a href="https://listenbrainz.org/user/adrianchen8662/">See my full listening history on ListenBrainz</a>
      </p>
    </aside>
  </div>
</PageLayout>
