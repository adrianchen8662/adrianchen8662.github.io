{
  "name": "site-api",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev -c wrangler.toml --test-scheduled",
    "deploy": "wrangler deploy -c wrangler.toml",
    "migrate": "wrangler d1 migrations apply DB -c wrangler.toml --remote",
    "migrate:local": "wrangler d1 migrations apply DB -c wrangler.toml --local",
    "typecheck": "tsc -p . && tsc -p test",
    "test": "node --test \"test/*.test.ts\"",
    "auth": "node scripts/spotify-auth.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0"
  }
}
